# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/

# Virtualenvs (the hub's and the MicroPython test environment)
.venv/
venv/
env/
mpyenv/
py39/
py312/
micropython/.venv/

# ---------------------------------------------------------------------------
# Local state and secrets — never commit these
# ---------------------------------------------------------------------------
# The hub creates these on first run; config.json holds the admin password
# hash, the session secret and the API key.
config.json
*.db
*.db-wal
*.db-shm
*.log
.token
devkey.txt
devdata.txt
.env

# Firmware secrets copied off a board
**/config.json
!device_types/*.json

# ---------------------------------------------------------------------------
# MicroPython build output
# ---------------------------------------------------------------------------
*.mpy
micropython/**/*.mpy

# ---------------------------------------------------------------------------
# Tooling output
# ---------------------------------------------------------------------------
scripts/shots/
*.png.tmp
docs/screenshots/*.tmp

# Flasher artefacts: downloaded firmware and browser/headless profiles
*.bin
*.uf2
*.elf
dbg-*/
tmp-*/
sh-layout-*/
sh-flashui-*/
sh-users-*/
sh-tabs-*/
sh-pwui-*/
pytest-of-*/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Scratch dirs from temporary Config/Store runs in tests or ad-hoc checks
tmp*/
